                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "quiz_id": {
                                                    "type": "integer",
                                                    "example": 8
                                                },
                                                "is_passed": {
                                                    "type": "boolean",
                                                    "example": true
                                                },
                                                "is_completed": {
                                                    "type": "boolean",
                                                    "example": true
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Quiz not found"
